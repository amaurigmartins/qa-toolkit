#!/bin/sh
set -eu

SELF=$(readlink -f -- "$0")
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$SELF")" && pwd)
REPOSITORY=$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd)
PYTHON=${QAT_PYTHON:-"$REPOSITORY/toolkit/python/bin/python"}

if [ ! -x "$PYTHON" ]; then
    PYTHON=python3
fi

PYTHONDONTWRITEBYTECODE=1 exec "$PYTHON" "$REPOSITORY/src/qa_toolkit/dispatch.py" "$@"
